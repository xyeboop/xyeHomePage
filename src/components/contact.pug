.content.content-contact
	.content-inner
		.wrap.fade
			.ai-chat-container
				.ai-chat-message.user-message
					span.prompt-label > User:
					span.typing-text(data-text=`${contact.aiPrompt}`) &nbsp;
				.ai-chat-message.ai-message
					span.prompt-label > AI:
					.ai-response
						.ai-thinking
							span.dot
							span.dot
							span.dot
						.contact-details(style="display:none")
							.contact-item
								span.contact-icon 📱
								span.contact-label Tel:
								span.contact-value #{contact.tel}
							.contact-item
								span.contact-icon 📧
								span.contact-label Email:
								span.contact-value #{contact.email}
							.contact-item
								span.contact-icon 💬
								span.contact-label WeChat:
								span.contact-value #{contact.wechat}
			a.contact-back.page-back #{contact.back}
