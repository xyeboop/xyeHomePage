.content.content-practice
	.content-inner
		.wrap.fade
			.ai-chat-container
				.ai-chat-message.user-message
					span.prompt-label > User:
					span.typing-text(data-text=`${practice.aiPrompt}`) &nbsp;
				.ai-chat-message.ai-message
					span.prompt-label > AI:
					.ai-response
						.ai-thinking
							span.dot
							span.dot
							span.dot
						.practice-details(style="display:none")
							h2.practice-title #{practice.aiTitle}
							p.practice-desc #{practice.aiDesc}
							.video-wrapper
								video#practiceVideo.video-player(preload="metadata" poster=`${practice.videoPoster}` disablepictureinpicture controlsList="nodownload nofullscreen")
									source(src=`${practice.videoPlaceholder}` type="video/mp4")
								.video-placeholder
									.play-icon ▶
									span.placeholder-text 点击播放产品动画
			a.practice-back.page-back #{practice.back}
