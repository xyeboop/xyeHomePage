.content.content-projects
	.content-inner
		.wrap.fade
			.ai-chat-container
				.ai-chat-message.user-message
					span.prompt-label > User:
					span.typing-text(data-text=`${projects.aiPrompt}`) &nbsp;
				.ai-chat-message.ai-message
					span.prompt-label > AI:
					.ai-response
						.ai-thinking
							span.dot
							span.dot
							span.dot
						.placeholder-content(style="display:none")
							.placeholder-icon 🚀
							p.placeholder-text #{projects.placeholder}
			a.projects-back.page-back ← Back
